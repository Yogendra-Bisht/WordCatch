# ─── Required ──────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or local docker mongo)
MONGO_URI=mongodb://localhost:27017/wordcatch

# Secret used to sign JWTs — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ─── Optional ──────────────────────────────────────────────────────────────
# Token lifetime (default: 7d). Examples: 1h, 7d, 30d
JWT_EXPIRES_IN=7d

# Port the Express server listens on inside the container (default: 3000)
PORT=3000

# CORS allowed origin in production — set to your extension's chrome-extension://<id>
# Leave unset or use * only during local development (NFR-6)
# EXTENSION_ORIGIN=chrome-extension://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
